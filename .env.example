# Memora — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# === Database ===
# Connection string for the application (non-superuser role)
DATABASE_URL=postgresql+asyncpg://memora_app:CHANGE_ME@localhost:5432/memora

# Connection string for migrations (schema-owner role)
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://memora_migrations:CHANGE_ME@localhost:5432/memora

# === Auth ===
# Admin token for namespace/key management (generate a strong random string)
ADMIN_TOKEN=CHANGE_ME_GENERATE_A_STRONG_TOKEN

# === Security ===
# Comma-separated allowed CORS origins (no wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session secret key for signing cookies
SESSION_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET

# === Rate Limits ===
RATE_LIMIT_GENERAL=120/minute
RATE_LIMIT_EMBEDDING=30/minute
RATE_LIMIT_COMPACTION=5/minute

# === Pointers ===
# Max pointer content size in bytes (default 200KB)
POINTER_MAX_SIZE_BYTES=204800
# Default pointer TTL in seconds (default 24h)
POINTER_DEFAULT_TTL_SECONDS=86400
# Max pointer TTL in seconds (default 7d)
POINTER_MAX_TTL_SECONDS=604800

# === Compaction ===
# Minimum age in days for memories to be eligible
COMPACTION_MIN_AGE_DAYS=7
# Importance threshold — memories with importance >= this are excluded
COMPACTION_IMPORTANCE_THRESHOLD=0.7
# Max memories per compaction batch
COMPACTION_BATCH_SIZE=100

# === Embedding ===
# Model loaded once at startup via fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# === App ===
# Set to "production" in deployed environments
APP_ENV=development
DEBUG=false
MAX_REQUEST_BODY_BYTES=1048576
